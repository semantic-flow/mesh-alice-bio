<alice> a foaf:Person ;
  foaf:name "Alice Ghostley" ;
  foaf:knows <carol> .

<bob> a foaf:Person ;
  foaf:name "Bob Newhart" ;
  foaf:knows <carol> .

<carol/data> a schema:Dataset ;
  dcterms:created "2026-05-25"^^xsd:date ;
  dcterms:creator <https://djradon.github.io/ns/dave-richardson> ;
  dcterms:description "Fixture-authored Carol Burnett biographical dataset used to exercise nested payload import, all-terms extraction, and richer ResourcePage relationship data in the Alice Bio mesh." ;
