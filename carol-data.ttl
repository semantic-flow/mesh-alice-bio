<carol> a foaf:Person ;
  foaf:name "Carol Burnett" ;
  foaf:givenName "Carol" ;
  foaf:familyName "Burnett" ;
  foaf:knows <alice>, <bob> ;
  foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Carol_Burnett> ;
  schema:alternateName "Carol Creighton Burnett" ;
  schema:additionalName "Creighton" ;
  schema:birthDate "1933-04-26"^^xsd:date ;
  schema:birthPlace "San Antonio, Texas, United States" ;
  schema:nationality "American" ;
  schema:gender "Female" ;
  schema:description "American comedian, actor, singer, writer, and television host known for The Carol Burnett Show and for a long stage, film, and television career." ;
  schema:hasOccupation "Actor", "Comedian", "Singer", "Television host", "Writer" ;
  schema:alumniOf "University of California, Los Angeles" ;
  schema:parent "Ina Louise Creighton", "Joseph Thomas Burnett" ;
  schema:spouse "Don Saroyan", "Joe Hamilton", "Brian Miller" ;
  schema:children "Carrie Hamilton", "Jody Hamilton", "Erin Hamilton" ;
  schema:knowsAbout "Broadway musical comedy", "Film parody", "Sketch comedy", "Variety television" ;
  schema:award "Carol Burnett Award inaugural honoree", "Golden Globe Award", "Grammy Award", "Hollywood Walk of Fame star", "Kennedy Center Honors", "Mark Twain Prize for American Humor", "Peabody Award", "People's Choice Award", "Presidential Medal of Freedom", "Primetime Emmy Award", "Screen Actors Guild Life Achievement Award", "Tony Award" ;
  schema:mainEntityOfPage <https://en.wikipedia.org/wiki/Carol_Burnett> ;
  schema:sameAs <https://www.britannica.com/biography/Carol-Burnett>, <https://www.imdb.com/name/nm0000993/>, <https://www.wikidata.org/wiki/Q255565> ;
