@base <https://semantic-flow.github.io/mesh-alice-bio/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<mesh-content/favicon/_knop> a sflo:Knop ;
  sflo:designatorPath "mesh-content/favicon" ;
  sflo:hasWorkingKnopInventoryFile <mesh-content/favicon/_knop/_inventory/inventory.ttl> .
