@base <https://semantic-flow.github.io/mesh-alice-bio/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<carol/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <carol/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <carol/_knop/_sources#extraction-source> .

<carol/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <carol/data> ;
  sflo:hasArtifactResolutionMode <https://semantic-flow.github.io/sflo/ontology/artifactResolutionMode_working> ;
  sflo:hasResolutionObservation <carol/_knop/_sources#extraction-source-observation-001> .

<carol/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetLocatedFile <carol-data.ttl>
  ] ;
  sflo:observedContentDigest "sha256:31fad2e9a96116242e9949b9aedafd0f8ab11e8c568537ba084a214fdaf26a2a" .

<carol/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
