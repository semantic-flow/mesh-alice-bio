  sflo:hasResourcePage <carol/data/_knop/_inventory/_history001/_s0001/ttl/index.html> .

<carol/data/_knop/_meta/meta.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<carol/data/_knop/_inventory/inventory.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<carol-data.ttl> a sflo:LocatedFile, sflo:RdfDocument .

