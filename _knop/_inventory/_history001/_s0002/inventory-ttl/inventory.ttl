<_knop/_inventory/_history001/_s0002/inventory-ttl/index.html> a sflo:ResourcePage, sflo:LocatedFile .


<_knop/_page/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<_knop/_page/_history001/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<_knop/_page/_history001/_s0001/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<_knop/_page/_history001/_s0001/page-ttl/index.html> a sflo:ResourcePage, sflo:LocatedFile .
